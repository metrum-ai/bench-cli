# Product-naming allowlist. Format: path-glob<TAB>regex
# See docs/NAMING.md. Keep this list minimal (shims + historical records).
Cargo.toml	name = "metrumbench
Cargo.toml	path = "src/bin/metrumbench
src/bin/metrumbench*	.
docs/CLI.md	metrumbench-
docs/STRATEGIC_BENCHMARKING.md	metrumbench-\* .*removed|shim
README.md	metrumbench-\*
CHANGELOG.md	.
docs/reviews/QUALITY_ASSESSMENT_REPORT.md	.
docs/reviews/QUALITY_ASSESSMENT_PROMPT.md	.
docs/HISTORY_REWRITE.md	.
