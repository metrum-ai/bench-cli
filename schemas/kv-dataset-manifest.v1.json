{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:metrum-ai:kv-dataset-manifest:v1",
  "$comment": "Copyright (c) 2026 Metrum AI, Inc. All rights reserved. SPDX-License-Identifier: Apache-2.0",
  "title": "KV dataset provenance and validation manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "origin", "rights", "adapter_id", "adapter_version", "field_mapping", "transformations", "tokenizer_revision", "chat_template_sha256", "generator_version", "corpus_rows", "selected_source_rows", "target_count", "selected_ids_sha256", "body_order_sha256", "checks", "exclusions", "limitations"],
  "properties": {
    "schema_version": {"const": "kv-dataset-manifest.v1"},
    "origin": {"$ref": "#/$defs/origin"},
    "rights": {"$ref": "#/$defs/rights"},
    "adapter_id": {"type": "string", "minLength": 1},
    "adapter_version": {"type": "string", "minLength": 1},
    "field_mapping": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "transformations": {"$ref": "#/$defs/strings"},
    "tokenizer_revision": {"type": ["string", "null"]},
    "chat_template_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "generator_version": {"type": ["string", "null"]},
    "corpus_rows": {"$ref": "#/$defs/countEvidence"},
    "selected_source_rows": {"type": "integer", "minimum": 0},
    "target_count": {"type": "integer", "minimum": 0},
    "selected_ids_sha256": {"$ref": "#/$defs/digest"},
    "body_order_sha256": {"$ref": "#/$defs/digest"},
    "checks": {"type": "object", "additionalProperties": {"$ref": "#/$defs/checkEvidence"}},
    "exclusions": {"$ref": "#/$defs/strings"},
    "limitations": {"$ref": "#/$defs/strings"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "strings": {"type": "array", "items": {"type": "string"}},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "origin": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "resolved_revision", "config", "split", "files"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "resolved_revision": {"type": "string", "pattern": "^[a-fA-F0-9]{40}$"},
        "config": {"type": "string", "minLength": 1},
        "split": {"type": "string", "minLength": 1},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}
      }
    },
    "rights": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "license", "license_text_sha256", "component_terms", "gated", "terms_review", "redistribution_allowed", "privacy_handling", "unresolved"],
      "properties": {
        "decision": {"enum": ["allowed", "denied", "review_required"]},
        "license": {"type": ["string", "null"]},
        "license_text_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "component_terms": {"type": "object", "additionalProperties": {"type": "string"}},
        "gated": {"type": "boolean"},
        "terms_review": {"type": ["string", "null"]},
        "redistribution_allowed": {"type": "boolean"},
        "privacy_handling": {"type": "string"},
        "unresolved": {"$ref": "#/$defs/strings"}
      }
    },
    "countEvidence": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"const": "unknown"}}},
        {"type": "object", "additionalProperties": false, "required": ["status", "value"], "properties": {"status": {"enum": ["measured", "publisher"]}, "value": {"type": "integer", "minimum": 0}}}
      ]
    },
    "checkEvidence": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"const": "unknown"}}},
        {"type": "object", "additionalProperties": false, "required": ["status", "value"], "properties": {"status": {"enum": ["measured", "publisher"]}, "value": {"type": "string"}}}
      ]
    },
    "envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "resolved_revision", "config", "split", "files", "adapter_id", "adapter_version", "license_spdx", "validation_manifest"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "resolved_revision": {"type": "string", "pattern": "^[a-fA-F0-9]{40}$"},
        "config": {"type": "string", "minLength": 1},
        "split": {"type": "string", "minLength": 1},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
        "adapter_id": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1},
        "license_spdx": {"type": ["string", "null"]},
        "validation_manifest": {
          "type": "object", "additionalProperties": false, "required": ["schema_version", "sha256"],
          "properties": {"schema_version": {"const": "kv-dataset-manifest.v1"}, "sha256": {"$ref": "#/$defs/digest"}}
        }
      }
    },
    "canonicalIds": {
      "type": "object",
      "required": ["record_id", "session_id", "trace_id", "turn_index"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "session_id": {"type": ["string", "null"]},
        "trace_id": {"type": ["string", "null"]},
        "turn_index": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
