{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/metrum-ai/bench-cli/schemas/logical-pressure-family.v1.json",
  "$comment": "Copyright (c) 2026 Metrum AI, Inc. All rights reserved.",
  "title": "Constructed logical pressure family, not runtime cache evidence",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "config", "requested_pool_nodes", "achieved_unique_nodes", "requested_pool_relation", "achieved_footprint_relation", "achieved_group_counts", "effective_group_order", "requests", "rendered_token_overlap", "physical_cache_evidence", "plan_sha256"],
  "properties": {
    "schema_version": {"const": "logical-pressure-family.v1"},
    "config": {"$ref": "#/$defs/config"},
    "requested_pool_nodes": {"$ref": "#/$defs/positive"},
    "achieved_unique_nodes": {"$ref": "#/$defs/positive"},
    "requested_pool_relation": {"$ref": "#/$defs/relation"},
    "achieved_footprint_relation": {"$ref": "#/$defs/relation"},
    "achieved_group_counts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/uint"}},
    "effective_group_order": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}},
    "requests": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["phase", "prefix_nodes"], "properties": {"phase": {"enum": ["populate", "pressure", "rehit"]}, "prefix_nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/uint"}}}}},
    "rendered_token_overlap": {"const": "unknown"},
    "physical_cache_evidence": {"const": "unavailable"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "uint": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "positive": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "positive32": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "relation": {"enum": ["unknown", "below", "equal", "above"]},
    "family": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "cyclic"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "weight_scale"], "properties": {"kind": {"const": "integer_zipf_one"}, "weight_scale": {"$ref": "#/$defs/positive"}}}
    ]},
    "config": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "groups", "blocks_per_group", "requests", "seed", "configured_capacity_blocks", "max_groups", "max_requests", "max_unique_nodes", "max_scheduled_nodes"],
      "properties": {
        "family": {"$ref": "#/$defs/family"},
        "groups": {"$ref": "#/$defs/positive32"},
        "blocks_per_group": {"$ref": "#/$defs/positive32"},
        "requests": {"$ref": "#/$defs/positive"},
        "seed": {"$ref": "#/$defs/uint"},
        "configured_capacity_blocks": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/positive"}]},
        "max_groups": {"$ref": "#/$defs/positive32"},
        "max_requests": {"$ref": "#/$defs/positive"},
        "max_unique_nodes": {"$ref": "#/$defs/positive"},
        "max_scheduled_nodes": {"$ref": "#/$defs/positive"}
      }
    }
  }
}
