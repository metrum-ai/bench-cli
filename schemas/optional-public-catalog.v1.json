{
  "$comment": "Copyright (c) 2026 Metrum AI, Inc. All rights reserved. SPDX-License-Identifier: Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional pinned discovery metadata, not source-access authorization",
  "type": "object", "additionalProperties": false,
  "required": ["$comment", "schema_version", "automatic_access_granted", "source_checks_run", "entries"],
  "properties": {
    "$comment": {"type": "string"},
    "schema_version": {"const": "optional-public-catalog.v1"},
    "automatic_access_granted": {"const": false}, "source_checks_run": {"const": false},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}}},
    "entry": {"type": "object", "additionalProperties": false,
      "required": ["key", "source_id", "revision", "support", "card_license_hint", "caveats", "file"],
      "properties": {
        "key": {"$ref": "#/$defs/text"}, "source_id": {"$ref": "#/$defs/text"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "support": {"enum": ["document_mapping", "review_only", "extraction_required"]},
        "card_license_hint": {"type": ["string", "null"]}, "caveats": {"$ref": "#/$defs/text"},
        "file": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/file"}]}
      }
    }
  }
}
