# Copy to .env on pikachu. Never commit real tokens.
# No AppArmor-related variables: the compose pool does not require it.
#
# Prefer a short-lived registration token from:
#   gh api -X POST repos/metrum-ai/bench-cli/actions/runners/registration-token --jq .token
# Put that in RUNNER_TOKEN (myoung34 image accepts ACCESS_TOKEN *or* RUNNER_TOKEN).
#
# Fine-grained PAT alternative: repo Administration + Actions (read/write) for
# runner management; set ACCESS_TOKEN and leave RUNNER_TOKEN empty.

REPO_URL=https://github.com/metrum-ai/bench-cli
RUNNER_SCOPE=repo
ORG_NAME=metrum-ai
LABELS=self-hosted,linux,x64,bench-cli
# Opt-in GPU runner (compose profile `gpu`, service runner-gpu) for
# .github/workflows/live-modality-smoke.yml. See MANUAL ("GPU runner").
GPU_LABELS=self-hosted,linux,x64,bench-cli,gpu-h100
# Host directory for the Hugging Face cache, mounted at the same path in the
# GPU runner. Set repository variable LIVE_HF_HOME to the same value.
HF_CACHE_DIR=/srv/hf-cache
EPHEMERAL=true
RUNNER_NAME_PREFIX=pikachu-bench-cli

# One of these:
RUNNER_TOKEN=
ACCESS_TOKEN=
