#
# Optional boot persistence. Install on pikachu:
#   sudo cp gha-bench-cli-pool.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now gha-bench-cli-pool
#
# Manual control stays: ~/github-runners-bench-cli-compose/pool restart

[Unit]
Description=GitHub Actions compose pool (bench-cli)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=cgadgil
Group=docker
WorkingDirectory=/home/cgadgil/github-runners-bench-cli-compose
ExecStart=/home/cgadgil/github-runners-bench-cli-compose/pool start
ExecStop=/home/cgadgil/github-runners-bench-cli-compose/pool stop
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
