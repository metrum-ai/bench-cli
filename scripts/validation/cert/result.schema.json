{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Copyright (c) 2026 Metrum AI, Inc. SPDX-License-Identifier: Apache-2.0",
  "title": "Certification result",
  "type": "object",
  "required": [
    "ID",
    "result",
    "observed_values",
    "thresholds",
    "evidence_paths",
    "attempt",
    "start_utc",
    "end_utc",
    "gpu_class",
    "driver",
    "versions"
  ],
  "properties": {
    "ID": {
      "type": "string",
      "pattern": "^BC-[A-Z]+-[0-9]{3}$"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "N-A"
      ]
    },
    "observed_values": {
      "type": "object"
    },
    "thresholds": {
      "type": "object"
    },
    "evidence_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "start_utc": {
      "type": "string",
      "format": "date-time"
    },
    "end_utc": {
      "type": "string",
      "format": "date-time"
    },
    "candidate_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gpu_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "driver": {
      "type": [
        "string",
        "null"
      ]
    },
    "versions": {
      "type": "object"
    },
    "reason": {
      "type": "string"
    },
    "request_clocks": {
      "type": "object",
      "required": ["first_request_utc", "last_request_utc"],
      "properties": {
        "first_request_utc": {"type": ["string", "null"], "format": "date-time"},
        "last_request_utc": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "input_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "output_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "infra_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {"type": {"enum": ["completed", "case_failed", "infra_interrupted", "infra_failed"]}}
      }
    },
    "carry_over_eligibility": {
      "type": "object",
      "required": ["eligible", "reason"],
      "properties": {
        "eligible": {"type": "boolean"},
        "reason": {"type": "string"}
      }
    }
  }
}
